# Kopier til .env.local og fyll inn verdier for CL-spillets EGET Supabase-/Vercel-/Resend-oppsett.
# Skal aldri peke mot vm-tipping/vmspillet sine ressurser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API-kilde for kampresultater - avhenger av hvilken CL-datakilde som velges
FOOTBALL_DATA_API_KEY=

SYNC_SECRET=
ADMIN_SECRET=
RESEND_API_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
