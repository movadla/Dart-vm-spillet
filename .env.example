# Kopier til .env.local og fyll inn verdier for dart-vm-spillets EGET Supabase-/Vercel-/Resend-oppsett.
# Skal aldri peke mot vm-tipping/vmspillet sine ressurser.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kampresultater og avansement legges inn manuelt via /admin (ingen fri PDC-resultat-API).
ADMIN_SECRET=
RESEND_API_KEY=

NEXT_PUBLIC_BASE_URL=http://localhost:3000
