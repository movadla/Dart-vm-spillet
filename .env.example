# Kopier til .env.local og fyll inn verdier for dart-vm-spillets Supabase-/
# Vercel-/Resend-oppsett.

# Kan gjerne peke mot SAMME Supabase-prosjekt som en annen app (f.eks.
# vm-tipping) — dart-vm-spillet lever i sitt eget Postgres-skjema ("dart_vm",
# se supabase/schema.sql), fullstendig atskilt fra andre appers tabeller/data
# i samme prosjekt. Skal likevel aldri peke mot vm-tipping/vmspillet sitt
# Vercel- eller Resend-oppsett — kun Supabase-prosjektet kan trygt deles.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kampresultater legges inn manuelt via /admin (ingen fri PDC-resultat-API).
ADMIN_SECRET=

# Sender-e-post via Resend, f.eks. oppdatering@ditt-domene.no (må være et verifisert domene i Resend).
RESEND_API_KEY=
EMAIL_DOMAIN=

# Hemmelighet cron-jobbene (daglig e-post, rang-snapshot) bruker for å autentisere seg mot API-et.
CRON_SECRET=
# Samme hemmelighet som repo-secreten SYNC_SECRET i .github/workflows/snapshot-ranks.yml.
SYNC_SECRET=

# Sikkerhetsventil mot at påmeldingen blir uventet stor uten at noen la merke
# til det — IKKE en ambisjonsgrense. Sett bevisst ut fra reell kapasitet
# (Supabase- og Resend-tier) før lansering, ikke la default stå ukommentert.
# (valgfri — default 2000 om utelatt, som er FOR LAVT for en større konkurranse).
MAX_PARTICIPANTS=10000

NEXT_PUBLIC_BASE_URL=http://localhost:3000
